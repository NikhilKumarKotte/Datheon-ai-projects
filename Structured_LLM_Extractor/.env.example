# -----------------------------------------------------------------------------
# Structured LLM Extractor Configuration
# -----------------------------------------------------------------------------

# Provider Selection: 'gemini', 'groq', 'cerebras', 'openrouter', or 'auto'
DEFAULT_PROVIDER=gemini

# 1. Google Gemini API (Primary / Multimodal Vision & Native Schemas)
# Obtain free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-3.5-flash-lite
FALLBACK_MODELS=["gemini-3.8-flash", "gemini-flash-latest"]

# 2. GroqCloud API (Ultra-Fast 500+ tok/s Inference & Free Developer Tier)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 3. Cerebras Cloud API (Wafer-Scale Ultra-Fast Inference & Free Developer Tier)
# Obtain free key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_DEFAULT_MODEL=llama3.3-70b

# 4. OpenRouter API (Universal Multi-Model Gateway & Free Models)
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
