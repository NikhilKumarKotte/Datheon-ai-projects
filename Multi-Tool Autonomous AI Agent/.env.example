# ==============================================================================
# Multi-Tool Autonomous AI Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Providers: openai, google, xai (Grok), anthropic, groq, openrouter, ollama, custom, mock
LLM_PROVIDER=xai
LLM_MODEL=grok-4.7
LLM_TEMPERATURE=0.0

# API Keys (Provide the one corresponding to your chosen LLM_PROVIDER)
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# For Google Gemini:
GOOGLE_API_KEY=your_google_api_key_here

# For xAI Grok Cloud API:
XAI_API_KEY=your_xai_api_key_here

# For Anthropic Claude:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For Groq:
GROQ_API_KEY=your_groq_api_key_here

# For OpenRouter:
OPENROUTER_API_KEY=your_openrouter_api_key_here

# For a custom OpenAI-compatible endpoint:
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://your-provider.example/v1

# For Ollama / Local LLM (if using LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Tool Configuration
# DuckDuckGo Search needs no API key (works out-of-the-box).
# Tavily Search (optional - if provided, enables enhanced web search):
TAVILY_API_KEY=

# Local File Reader Configuration
# Base directory for the file reader tool (defaults to current working directory)
FILE_READER_BASE_DIR=.
# Maximum file size allowed to be read in bytes (default: 1MB = 1048576)
MAX_FILE_READ_BYTES=1048576

# Agent Execution Settings
MAX_ITERATIONS=10
VERBOSE_OUTPUT=true
