# ==============================================================================
# Monorepo Root .gitignore - Datheon Projects Suite
# ==============================================================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*/.venv/
*/venv/
*/env/

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Environment Variables & Secrets (CRITICAL: Do NOT commit secrets!)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example
*.local
*.pem
*.key
.streamlit/secrets.toml
*/.streamlit/secrets.toml

# Testing & Caches
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Vector Databases, Local Runtime Data & Dynamic Stores
*.db
*.sqlite3
data/*.db
data/semantic_memory/
data/chroma_db/
data/faiss_db/
data/uploads/
*/data/*.db
*/data/semantic_memory/
*/data/chroma_db/
*/data/faiss_db/
*/data/uploads/
tests/test_store_data/
*/tests/test_store_data/

# User Uploads and Temporary Artifacts
*/docx_media/
user_uploads/*
!user_uploads/.gitkeep
*/user_uploads/*
!*/user_uploads/.gitkeep

# Generated Outputs & Logs
*.log
*/logs/
docx_extracted.txt
pptx_extracted.txt
*/docx_extracted.txt
*/pptx_extracted.txt
output.json
*output.json
*/output.json
*/invoice_output.json
*/receipt_output.json
*/resume_output.json
*/docx_resume_output.json
*/pdf_invoice_output.json

# IDE & Operating System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
